{
  "name": "ashen-vale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "中世纪生存 demo：TypeScript + PixiJS + 自定义 ECS（参考 goengine 的渲染/动画/模拟分层）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:standalone": "tsc --noEmit && vite build --mode standalone",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "node scripts/test.mjs",
    "shot": "node tests/render/run-shot.mjs",
    "export:standalone": "npm run build:standalone && node scripts/export-standalone.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.6.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
